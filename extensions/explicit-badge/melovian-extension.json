{
  "id": "explicit-badge",
  "name": "Explicit badge",
  "version": "1.0.0",
  "description": "Adds an [E] title prefix and a red progress bar to tracks marked explicit in the title or by an explicit tag.",
  "author": "Melovian",
  "icon": "assets/icon.svg",
  "trackRules": [
    {
      "match": {
        "titleRegex": "[\\[(](explicit|18\\+)[\\])]"
      },
      "decoration": {
        "titlePrefix": "[E] ",
        "progressColor": "#d64545",
        "icon": "alert-triangle"
      }
    },
    {
      "match": {
        "tagEquals": "explicit"
      },
      "decoration": {
        "titlePrefix": "[E] ",
        "progressColor": "#d64545",
        "icon": "alert-triangle"
      }
    }
  ]
}
