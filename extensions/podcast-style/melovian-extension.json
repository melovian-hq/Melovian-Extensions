{
  "id": "podcast-style",
  "name": "Podcast progress style",
  "version": "1.0.1",
  "description": "Orange progress bar and a microphone icon on podcast episodes. Matches a podcast genre or the word podcast in the title.",
  "author": "Melovian",
  "license": "Apache-2.0",
  "homepage": "https://github.com/melovian-hq/Melovian-Extensions",
  "tags": [
    "podcast",
    "progress"
  ],
  "icon": "assets/icon.svg",
  "trackRules": [
    {
      "match": {
        "genreContains": "podcast"
      },
      "decoration": {
        "progressColor": "#e67e22",
        "icon": "microphone"
      }
    },
    {
      "match": {
        "titleContains": "podcast"
      },
      "decoration": {
        "progressColor": "#e67e22",
        "icon": "microphone"
      }
    }
  ],
  "permissions": [
    "track-decorations"
  ]
}
