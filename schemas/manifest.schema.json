{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melovian-hq.github.io/Melovian-Extensions/schemas/manifest.schema.json",
  "title": "Melovian extension manifest",
  "description": "Schema for melovian-extension.json, the manifest at the root of every extension package.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Package id. Also the directory name under extensions/."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "type": "string", "maxLength": 120 },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "description": "Project homepage or source URL, https only."
    },
    "license": {
      "type": "string",
      "maxLength": 64,
      "description": "SPDX identifier, for example Apache-2.0."
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["styles", "script", "theme", "track-decorations", "player-hooks"]
      },
      "description": "Explicit capability contract. The audit fails when the package uses a capability that is not declared here."
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$",
      "description": "Oldest Melovian version that can run this extension. The app refuses older installs."
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "description": "Ids of other registry extensions this one depends on."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" },
      "description": "Image paths relative to the extension folder, shown on the registry site."
    },
    "icon": {
      "type": "string",
      "description": "Image path relative to the extension folder, for example assets/icon.svg."
    },
    "image": {
      "type": "string",
      "description": "Larger artwork path relative to the extension folder."
    },
    "appTheme": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Named app chrome theme this extension offers, for example neon-arcade."
    },
    "styles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Stylesheet paths relative to the extension folder. Injected while the extension is enabled."
    },
    "script": {
      "type": "string",
      "description": "Sandboxed script path relative to the extension folder (.js, .mjs, or .ts; TypeScript is stripped to JS at pack time)."
    },
    "trackRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/trackRule" }
    },
    "playerHooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/playerHook" }
    },
    "settings": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/settingField" },
      "description": "User-facing settings rendered as a form in the app. Values reach scripts via api.settings."
    }
  },
  "$defs": {
    "trackRule": {
      "type": "object",
      "required": ["match", "decoration"],
      "properties": {
        "match": { "$ref": "#/$defs/trackMatch" },
        "decoration": { "$ref": "#/$defs/trackDecoration" }
      }
    },
    "trackMatch": {
      "type": "object",
      "properties": {
        "genreContains": { "type": "string" },
        "artistContains": { "type": "string" },
        "albumContains": { "type": "string" },
        "titleContains": { "type": "string" },
        "titleRegex": { "type": "string", "maxLength": 256 },
        "tagEquals": { "type": "string" },
        "minRating": { "type": "integer", "minimum": 0, "maximum": 5 },
        "isLocal": { "type": "boolean" }
      }
    },
    "trackDecoration": {
      "type": "object",
      "properties": {
        "progressColor": { "type": "string" },
        "progressGradient": { "type": "string" },
        "progressThumbUrl": { "type": "string" },
        "progressParticleUrl": { "type": "string" },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "iconUrl": { "type": "string" },
        "titlePrefix": { "type": "string", "maxLength": 40 },
        "coverOverlayIcon": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "playerTheme": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
      }
    },
    "playerHook": {
      "type": "object",
      "required": ["when"],
      "properties": {
        "when": { "type": "string" },
        "style": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "settingField": {
      "type": "object",
      "required": ["key", "type"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "label": { "type": "string", "maxLength": 80 },
        "type": { "enum": ["boolean", "choice", "text"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "default": {}
      }
    }
  }
}
