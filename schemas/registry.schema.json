{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melovian-hq.github.io/Melovian-Extensions/schemas/registry.schema.json",
  "title": "Melovian extension registry index",
  "description": "Schema for registry.json, generated by tools/build.mjs. Consumed by melovian-web and by the Melovian app for remote install.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "extensions"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "package", "capabilities", "audit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "icon": {
          "type": "string",
          "description": "Image path relative to the registry base URL."
        },
        "image": {
          "type": "string",
          "description": "Artwork path relative to the registry base URL."
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "bytes"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script", "wasm", "styles", "appTheme", "trackRules", "playerHooks"],
          "properties": {
            "script": { "type": "boolean" },
            "wasm": { "type": "boolean" },
            "styles": { "type": "integer", "minimum": 0 },
            "appTheme": { "type": "boolean" },
            "trackRules": { "type": "integer", "minimum": 0 },
            "playerHooks": { "type": "integer", "minimum": 0 }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "warnings"],
          "properties": {
            "status": { "const": "pass" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
