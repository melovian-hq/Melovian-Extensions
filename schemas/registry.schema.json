{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melovian-hq.github.io/Melovian-Extensions/schemas/registry.schema.json",
  "title": "Melovian extension registry index",
  "description": "Schema for registry.json, generated by tools/build.mjs. Consumed by melovian-web and by the Melovian app for remote install.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "extensions"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "package", "capabilities", "audit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "screenshots": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Image paths relative to the registry base URL."
        },
        "externalUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "Every external URL found in the package, for the privacy display."
        },
        "risk": { "enum": ["low", "medium", "high"] },
        "changelog": {
          "type": "array",
          "items": { "$ref": "#/$defs/release" },
          "description": "Parsed from the extension CHANGELOG.md, newest first."
        },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/versionEntry" },
          "description": "Download history, newest first. Older entries stay installable."
        },
        "icon": {
          "type": "string",
          "description": "Image path relative to the registry base URL."
        },
        "image": {
          "type": "string",
          "description": "Artwork path relative to the registry base URL."
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "bytes"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 },
            "signature": {
              "type": "string",
              "description": "Ed25519 signature over the zip bytes, base64."
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script", "wasm", "styles", "appTheme", "trackRules", "playerHooks"],
          "properties": {
            "script": { "type": "boolean" },
            "wasm": { "type": "boolean" },
            "styles": { "type": "integer", "minimum": 0 },
            "appTheme": { "type": "boolean" },
            "trackRules": { "type": "integer", "minimum": 0 },
            "playerHooks": { "type": "integer", "minimum": 0 }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "warnings"],
          "properties": {
            "status": { "const": "pass" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "notes"],
      "properties": {
        "version": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },
    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256", "bytes", "releasedAt"],
      "properties": {
        "version": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "signature": { "type": "string" },
        "releasedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    }
  }
}
